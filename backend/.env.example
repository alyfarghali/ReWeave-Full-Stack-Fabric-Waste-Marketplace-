# Copy to backend/.env. A repo-root .env is also read, for anything unset here.

# --- Core -------------------------------------------------------------------

# Postgres in production (e.g. a Supabase pooler URI). Unset = local SQLite file
# backend/scraps.db, which is fine for development.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Signs JWT access tokens. Required in any shared environment; generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# TOKEN_EXPIRE_HOURS=8

# Browser origins allowed to call the API directly (comma-separated). The Vite
# dev server proxies /api, so this only matters for split-origin deployments.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo logins + buyer catalog into an empty database (true/false).
# SEED_DEMO_DATA=true

# Timezone for human-readable timestamps on the admin dashboard.
# DISPLAY_TIMEZONE=America/New_York

# --- AI services ------------------------------------------------------------

# OpenRouter: vision material classification, destination naming, assistant.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_VISION_MODELS=google/gemini-2.5-flash,anthropic/claude-sonnet-4.6,openai/gpt-4o
# OPENROUTER_TIMEOUT_S=60

# Replicate: Segment Anything masks for the scan pipeline.
REPLICATE_API_TOKEN=r8_your-token-here
# REPLICATE_SAM_MODEL=lucataco/segment-anything-2
# Optional always-warm deployment ("owner/deployment-name") to skip cold starts.
# REPLICATE_DEPLOYMENT=

# --- Vision pipeline tuning -------------------------------------------------

# ARUCO_MARKER_SIZE_CM=5.0
# ARUCO_MARKER_ID=23
# VISION_MAX_IMAGE_DIMENSION=1600
# VISION_MAX_PIECES=35
