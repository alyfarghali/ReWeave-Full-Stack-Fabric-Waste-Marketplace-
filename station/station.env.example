# Copy to /etc/reweave-station.env (for the service) or pass with --env-file.

# Backend the station uploads to, and a factory account to sign in with.
REWEAVE_API_URL=https://reweave.example.com
REWEAVE_EMAIL=station-1@yourfactory.com
REWEAVE_PASSWORD=change-me

# Where this station is. Every lot it lists is pinned here on the buyer map.
STATION_LAT=33.7490
STATION_LNG=-84.3880

# Wiring (BCM pin numbers). Leave STATUS_LED_GPIO empty if there's no light.
BUTTON_GPIO=17
STATUS_LED_GPIO=27

# Optional tuning
# CAPTURE_DIR=~/reweave-station/captures
# KEEP_CAPTURES=20
# CAPTURE_WIDTH=4608
# CAPTURE_HEIGHT=2592
# USE_DEPLOYMENT=true
# REQUEST_TIMEOUT_S=240
